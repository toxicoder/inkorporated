# Bazelisk-first configuration for the Inkorporated monorepo.
# The toolchain version is pinned in .bazelversion; do not rely on a host Bazel.

# Hermetic shell rules come from @rules_shell (see MODULE.bazel).
common --enable_bzlmod

# Keep build and test output free of network-dependent surprises.
common --enable_workspace=false

# Reproducible output roots and a stable cache location.
build --experimental_repo_remote_exec=false
build --show_progress_rate_limit=5

# Test defaults: fail loudly, keep logs for the gate report.
test --test_output=errors
test --test_verbose_timeout_warnings
