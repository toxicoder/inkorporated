# INKORPORATED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .devcontainer/.env and set values. Then: chmod 600 .devcontainer/.env

# GITHUB Configuration - Personal Access Token (scopes: repo, read:org, workflow)
GH_TOKEN=your_github_token_here

# Perplexity AI API Key
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# NVIDIA DGX SPARK Nodes
NVIDIA_DGX_SPARK_0_IP=192.168.1.100
NVIDIA_DGX_SPARK_1_IP=192.168.1.101
