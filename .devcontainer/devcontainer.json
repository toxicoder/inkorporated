{
    "name": "Ultimate Dev Container (Ubuntu 24.04 Multi-Arch)",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": false,
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        },
        "ghcr.io/devcontainers-community/features/bazel:1": {
            "bazelisk_version": "latest",
            "buildifier_version": "latest"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/terraform:1": {
            "version": "latest",
            "tflint": "latest",
            "terragrunt": "latest"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest",
            "helm": "latest",
            "minikube": "none"
        }
    },
    "remoteEnv": {
        "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
        "BRAVE_API_KEY": "${localEnv:BRAVE_API_KEY}"
    },
    "postCreateCommand": "echo '✅ Ultimate dev environment ready! Run node --version, python --version, docker --version, bazel --version to verify.'",
    "hostRequirements": {
        "cpus": 2,
        "memory": "4gb",
        "storage": "10gb",
        "gpu": "optional"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "4ops.terraform",
                "aaron-bond.better-comments",
                "bazelbuild.vscode-bazel",
                "bierner.markdown-mermaid",
                "bmewburn.vscode-intelephense-client",
                "Dart-Code.dart-code",
                "DavidAnson.vscode-markdownlint",
                "dbaeumer.vscode-eslint",
                "dsznajder.es7-react-js-snippets",
                "eamodio.gitlens",
                "ecmel.vscode-html-css",
                "EditorConfig.EditorConfig",
                "esbenp.prettier-vscode",
                "firefox-devtools.vscode-firefox-debug",
                "foxundermoon.shell-format",
                "GitHub.github-vscode-theme",
                "GitHub.remotehub",
                "github.vscode-github-actions",
                "GitHub.vscode-pull-request-github",
                "golang.go",
                "Gruntfuggly.todo-tree",
                "hashicorp.terraform",
                "humao.rest-client",
                "kilocode.Kilo-Code",
                "monokai.theme-monokai-pro-vscode",
                "ms-azuretools.vscode-docker",
                "ms-dotnettools.csharp",
                "ms-dotnettools.vscode-dotnet-runtime",
                "ms-edgedevtools.vscode-edge-devtools",
                "ms-python.black-formatter",
                "ms-python.debugpy",
                "ms-python.flake8",
                "ms-python.pylint",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-vscode-remote.remote-containers",
                "ms-vscode-remote.remote-repositories",
                "ms-vscode-remote.remote-ssh-edit",
                "ms-vscode-remote.remote-ssh",
                "ms-vscode-remote.vscode-containers",
                "ms-vscode-remote.vscode-remote-extensionpack",
                "ms-vscode.azure-repos",
                "ms-vscode.remote-explorer",
                "ms-vscode.remote-server",
                "ms-vscode.vscode-json",
                "ms-vscode.vscode-typescript-next",
                "ms-vscode.vscode-yaml",
                "ms-windows-ai-studio.windows-ai-studio",
                "ParallelsDesktop.parallels-desktop",
                "PKief.material-icon-theme",
                "redhat.java",
                "redhat.vscode-yaml",
                "ritwickdey.LiveServer",
                "RobbOwen.synthwave-vscode",
                "rust-lang.rust-analyzer",
                "saoudrizwan.claude-dev",
                "sdras.night-owl",
                "Shopify.ruby-lsp",
                "streetsidesoftware.code-spell-checker",
                "timonwong.shellcheck",
                "usernamehw.errorlens",
                "vscjava.vscode-gradle",
                "vscjava.vscode-java-debug",
                "vscjava.vscode-java-dependency",
                "vscjava.vscode-java-pack",
                "vscjava.vscode-java-test",
                "vscjava.vscode-maven",
                "vscodevim.vim",
                "Vue.volar"
            ],
            "unwantedRecommendations": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "github.vscode-github-actions"
            ]
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/terraform",
        "ghcr.io/devcontainers/features/kubectl-helm-minikube"
    ]
}
