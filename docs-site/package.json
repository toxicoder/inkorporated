{
  "name": "inkorporated-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:latest": "DOCS_ALIAS=latest next build --webpack",
    "build:development": "DOCS_ALIAS=development INK_DOCS_VERSION=development next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "nav:generate": "python3 scripts/gen_nav.py",
    "nav:check": "python3 scripts/gen_nav.py --check",
    "codemod": "python3 scripts/codemod_mkdocs_to_mdx.py",
    "codemod:check": "python3 scripts/codemod_mkdocs_to_mdx.py --check",
    "unit": "vitest run",
    "serve": "node scripts/serve_static.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
