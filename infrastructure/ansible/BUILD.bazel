# Ansible gate: lints the playbooks, roles, and inventory owned by this package.

load("//build:defs.bzl", "repo_sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "playbooks",
    # glob-policy: one playbook per file; the tree grows by design as cluster
    # steps are automated.
    srcs = glob(["playbooks/**/*.yml"]),
)

filegroup(
    name = "roles",
    # glob-policy: a role is a payload tree (tasks/vars/templates) that grows by
    # design with every automated step.
    srcs = glob(["roles/**"]),
)

filegroup(
    name = "inventory",
    # glob-policy: hosts and group_vars grow by design with every node group.
    srcs = glob(["inventory/**"]),
)

repo_sh_test(
    name = "ansible_lint",
    srcs = ["ansible_lint_wrapper.sh"],
    data = [
        "ansible.cfg",
        ":inventory",
        ":playbooks",
        ":roles",
    ],
    args = ["--strict", "--force-color"],
    # ansible resolves a bare role name against $CWD/roles, and a test runs at
    # the runfiles root, so the package's roles/ has to be named explicitly or
    # syntax-check reports roles that are right there in the tree.
    env = {"ANSIBLE_ROLES_PATH": "infrastructure/ansible/roles"},
    tags = ["gate", "ansible", "lint", "slow"],
    strict = True,
)


# Package documentation: the runbook a person reads before touching a playbook.
filegroup(
    name = "docs",
    srcs = ["README.md"],
)

# Galaxy collection requirements travel with the roles that need them; the lint
# lane names this file when it refuses to run without them.
filegroup(
    name = "requirements",
    srcs = ["requirements.yml"],
)
