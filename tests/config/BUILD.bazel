# Configuration validation: schema checks, environment inheritance, and the
# secret scanner for committed configuration.

load("//build:defs.bzl", "repo_sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "scripts",
    srcs = [
        "scan_secrets.sh",
        "test_config_validation.sh",
        "test_env_vars.sh",
        "test_environment_inheritance.sh",
        "test_scan_secrets_assertions.sh",
        "test_validate_infrastructure.sh",
        "test_validation_script.sh",
        "validate_infrastructure.sh",
    ],
)

# Needs the operator's real secrets file, so it is a host lane and //:gate does
# not run it. The hermetic counterpart that reads the committed template is
# //:validate_config_template.
repo_sh_test(
    name = "test_config_validation",
    srcs = ["test_config_validation.sh"],
    data = [
        "//config:all_configs",
        "//:validate_config_sh",
    ],
    tags = ["host", "manual", "config"],
)

repo_sh_test(
    name = "test_env_vars",
    srcs = ["test_env_vars.sh"],
    data = [
        "//config:all_configs",
        "//.devcontainer:env_example",
        "//tools/bazel:secrets_allowlist",
        "//:validate_config_sh",
    ],
    tags = ["gate", "config"],
    timeout = "short",
)

repo_sh_test(
    name = "test_environment_inheritance",
    srcs = ["test_environment_inheritance.sh"],
    data = [
        "//config:all_configs",
        "//.devcontainer:env_example",
    ],
    tags = ["gate", "config"],
    timeout = "short",
)

# Needs a real Proxmox node (pvecm, systemctl) plus the Synology NFS export, so
# it is tagged host + manual and //:gate never runs it.
repo_sh_test(
    name = "validate_infrastructure",
    srcs = ["validate_infrastructure.sh"],
    data = [
        "//config:all_configs",
    ],
    tags = ["host", "manual", "infra"],
)

# The decision logic of the validator above, exercised against fixtures and fake
# host binaries, so it belongs in the gate.
repo_sh_test(
    name = "test_validate_infrastructure",
    srcs = ["test_validate_infrastructure.sh"],
    data = [
        "validate_infrastructure.sh",
        "//config:all_configs",
    ],
    strict = True,
    tags = ["gate"],
    timeout = "short",
)

repo_sh_test(
    name = "test_validation_script",
    srcs = ["test_validation_script.sh"],
    data = [
        "//:validate_config_sh",
        "//config:all_configs",
        "//.devcontainer:env_example",
        "//tools/bazel:secrets_allowlist",
    ],
    tags = ["gate", "config"],
    timeout = "short",
)

repo_sh_test(
    name = "config_security_scan",
    srcs = ["scan_secrets.sh"],
    data = [
        "//config:all_configs",
        "//apps:manifests",
        "//infrastructure/ansible:playbooks",
        "//tools/bazel:secrets_allowlist",
    ],
    tags = ["gate", "security"],
    timeout = "short",
)

# Guards the assertion shape of the lane above. Issue #45 was a shell race in
# scan_secrets.sh, not a detector miss: a `printf | grep -q` pipeline under
# pipefail reports failure for a finding grep had already matched. Needs the
# scanner as data because it reads the assertion shape straight out of it.
repo_sh_test(
    name = "test_scan_secrets_assertions",
    srcs = ["test_scan_secrets_assertions.sh"],
    data = [
        "scan_secrets.sh",
    ],
    tags = ["gate", "security"],
    timeout = "short",
)

